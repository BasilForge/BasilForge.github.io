---
import Shot from './Shot.astro';
import type { Lang } from '../i18n/ui';
import type { Feature } from '../projects';

interface Props {
  feature: Feature;
  slug: string;
  lang: Lang;
  index: number;
}

const { feature, slug, lang, index } = Astro.props;
---

<article class:list={['feature', { flip: index % 2 === 1 }]} id={feature.id} data-reveal>
  <div class="text">
    <p class="num" dir="ltr">{String(index + 1).padStart(2, '0')}</p>
    <h3>{feature.title[lang]}</h3>
    <p class="body">{feature.body[lang]}</p>
  </div>
  <div class="picture">
    <Shot slug={slug} lang={lang} image={feature.image} alt={feature.alt[lang]} sizes="(min-width: 960px) 620px, 92vw" />
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(24px, 5vw, 72px);
  }

  .flip {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  }

  .flip .text {
    order: 2;
  }

  .num {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-text);
  }

  h3 {
    margin-top: 8px;
    font-size: clamp(26px, 3.2vw, 38px);
  }

  .body {
    margin-top: 14px;
    max-width: 44ch;
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
    }

    .flip .text {
      order: 0;
    }
  }
</style>
