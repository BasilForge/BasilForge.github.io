---
import Base from '../layouts/Base.astro';
import DownloadPanel from './DownloadPanel.astro';
import VideoBlock from './VideoBlock.astro';
import Feature from './Feature.astro';
import Shot from './Shot.astro';
import Icon from './Icon.astro';
import LiveStats from './LiveStats.astro';
import { localePath, t, type Lang } from '../i18n/ui';
import type { KairosStats } from '../lib/github';
import type { Project } from '../projects';

interface Props {
  project: Project;
  stats: KairosStats;
  lang: Lang;
}

const { project, stats, lang } = Astro.props;
const s = t(lang);
---

<Base
  lang={lang}
  title={`${project.name} · BasilForge`}
  description={project.tagline[lang]}
  path={localePath(lang, `/${project.slug}/`)}
  ogImage={project.ogImage}
>
  <section class="container hero">
    <h1 data-reveal><img src={project.logo} alt={project.name} width="375" height="105" /></h1>
    <p class="headline" data-reveal>{project.headline[lang]}</p>
    <p class="summary muted" data-reveal>{project.summary[lang]}</p>
    <div data-reveal><DownloadPanel project={project} stats={stats} lang={lang} /></div>
    <div class="hero-shot" data-reveal>
      <Shot slug={project.slug} lang={lang} image={project.hero.image} alt={project.hero.alt[lang]} sizes="(min-width: 1180px) 1120px, 94vw" eager />
    </div>
  </section>

  {
    project.video && (
      <section class="container section" aria-labelledby="watch">
        <h2 id="watch" class="section-title display-title" data-reveal>{s['page.watch']}</h2>
        <VideoBlock video={project.video} label={s['page.watch']} />
      </section>
    )
  }

  <section class="container section features" aria-labelledby="features">
    <h2 id="features" class="section-title display-title" data-reveal>{s['page.features']}</h2>
    {project.features.map((feature, index) => <Feature feature={feature} slug={project.slug} lang={lang} index={index} />)}
  </section>

  <section class="container section news" aria-labelledby="news">
    <div class="card news-card" data-reveal>
      <h2 id="news" class="display-title">{s['page.whatsNew']} <span dir="ltr">{project.name} {project.whatsNew.version}</span></h2>
      <ul>
        {project.whatsNew.items.map((item) => <li>{item[lang]}</li>)}
      </ul>
    </div>
  </section>

  <section class="container info" aria-label={`${s['page.requirements']} · ${s['page.support']}`}>
    <div class="card" data-reveal>
      <h2>{s['page.requirements']}</h2>
      <p class="muted">{project.requirements[lang]}</p>
    </div>
    <div class="card" data-reveal>
      <h2>{s['page.support']}</h2>
      <ul class="links">
        <li><a href={project.links.discord}><Icon name="discord" />{s['page.discord']}</a></li>
        <li><a href={project.links.issues}><Icon name="github" />{s['page.report']}</a></li>
        {project.links.security && <li><a href={project.links.security}><Icon name="arrow" class="flip-rtl" />{s['page.security']}</a></li>}
        <li><a href={project.links.github}><Icon name="arrow" class="flip-rtl" />{s['page.source']}</a></li>
      </ul>
    </div>
  </section>

  <section class="container section cta" data-reveal>
    <h2 class="display-title">{s['page.ctaTitle']}</h2>
    <a class="btn btn-primary btn-lg" href={stats.setupUrl} data-setup-link>
      <Icon name="download" />{s.download} {project.name}
      <span class="btn-badge" dir="ltr" data-stat="version">v{stats.version}</span>
    </a>
  </section>

  <LiveStats />
</Base>

<style>
  .hero {
    position: relative;
    padding-top: clamp(40px, 7vw, 88px);
    display: grid;
    gap: 20px;
  }

  /* the night scene's light, faint behind the top of the page, so every page shares the home page's mood */
  .hero::before {
    content: '';
    position: absolute;
    inset: -68px calc(50% - 50vw) auto;
    height: 640px;
    z-index: -1;
    background: url(/media/theme/moon-poster.webp) 50% 30% / cover;
    filter: blur(40px) saturate(1.3);
    opacity: 0.32;
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
    pointer-events: none;
  }

  h1 img {
    height: clamp(64px, 9vw, 104px);
    width: auto;
  }

  .headline {
    max-width: 18ch;
    font-size: clamp(34px, 5.4vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  :lang(ar) .headline {
    letter-spacing: 0;
    line-height: 1.3;
  }

  .summary {
    max-width: 52ch;
    font-size: clamp(17px, 1.7vw, 20px);
  }

  .hero-shot {
    margin-top: clamp(24px, 4vw, 48px);
  }

  .section-title {
    margin-bottom: clamp(24px, 4vw, 48px);
    font-size: clamp(30px, 4.4vw, 52px);
  }

  .features {
    display: grid;
    gap: clamp(64px, 10vw, 128px);
  }

  .features .section-title {
    margin-bottom: 0;
  }

  .news-card {
    padding: clamp(24px, 4vw, 48px);
  }

  .news-card h2 {
    font-size: clamp(26px, 3.4vw, 40px);
  }

  .news-card ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 14px 32px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .news-card li {
    position: relative;
    padding-inline-start: 26px;
    font-size: 17px;
  }

  .news-card li::before {
    content: '';
    position: absolute;
    inset-inline-start: 2px;
    top: 0.62em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }

  .info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 24px;
  }

  .info .card {
    padding: clamp(22px, 3vw, 36px);
  }

  .info h2 {
    margin-bottom: 12px;
    font-size: 24px;
  }

  .links {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }

  .links :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .cta {
    display: grid;
    justify-items: center;
    gap: 24px;
    text-align: center;
  }

  .cta h2 {
    font-size: clamp(30px, 4.4vw, 52px);
  }


</style>
