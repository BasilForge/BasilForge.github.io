---
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import LiveStats from './LiveStats.astro';
import SceneHeader from './SceneHeader.astro';
import { localePath, t, type Lang } from '../i18n/ui';
import { projects } from '../projects';
import { kairosStatsForBuild } from '../lib/github';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const stats = await kairosStatsForBuild();
---

<Base lang={lang} title="BasilForge" description={s['home.description']} path={localePath(lang, '/')} ogImage={projects[0].ogImage}>
  <SceneHeader title={s['home.title']} />

  <section class="container works" aria-labelledby="work-title">
    {projects.map((project) => <ProjectCard project={project} lang={lang} stats={stats} />)}
  </section>

  <LiveStats />
</Base>

<style>
  .works {
    position: relative;
    margin-top: clamp(-8px, -0.5vw, 0px); /* the card starts where the scene's water fades out */
    display: grid;
    gap: 24px;
    padding-bottom: clamp(56px, 9vw, 112px);
  }
</style>
