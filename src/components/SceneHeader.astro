---
import '@fontsource/cinzel/800.css';
import '@fontsource/aref-ruqaa/700.css';
/** The home page's moving night scene: a short looping video that melts into the page's black on every side. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="scene-header">
  <div class="scene-wrap" aria-hidden="true">
    <div class="scene">
    <video autoplay muted loop playsinline preload="metadata" poster="/media/theme/moon-poster.webp" data-scene>
      <source src="/media/theme/moon-1440.mp4" type="video/mp4" media="(min-width: 1200px)" />
      <source src="/media/theme/moon-1080.mp4" type="video/mp4" />
    </video>
    </div>
  </div>
  <div class="container titles">
    <h1 id="work-title" data-reveal>{title}</h1>
  </div>
</section>

<style>
  .scene-header {
    position: relative;
    margin-top: -68px; /* under the sticky header */
  }

  /* edge to edge: the scene fills the width, keeps the moon, the fire and the water in view, and melts into the
     page's black through a long, soft fade at the bottom */
  .scene-wrap {
    position: relative;
  }

  .scene {
    position: relative;
    width: 100%;
    height: min(40vw, 58vh);
    min-height: 220px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 70%, rgb(0 0 0 / 0.6) 84%, rgb(0 0 0 / 0.2) 94%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 70%, rgb(0 0 0 / 0.6) 84%, rgb(0 0 0 / 0.2) 94%, transparent 100%);
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 74%;
  }

  /* the title sits on the bottom of the scene, so the work card can start right where the water fades out */
  .titles {
    position: absolute;
    inset-inline: 0;
    bottom: 16%;
    display: grid;
    gap: 6px;
    justify-items: start;
  }

  /* the title in the scene's own light: white at the top fading into crystal blue */
  h1 {
    font-family: 'Cinzel', serif;
    font-weight: 800;
    font-size: clamp(34px, 5.6vw, 72px);
    line-height: 1.1;
    letter-spacing: 0.04em;
    background: linear-gradient(180deg, #ffffff 0%, #cfe0ff 35%, #7f9cff 75%, #4a63e0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 4px 22px rgb(74 99 224 / 0.45)) drop-shadow(0 2px 6px rgb(8 7 15 / 0.8));
  }

  :lang(ar) h1 {
    font-family: 'Aref Ruqaa', serif;
    font-weight: 700;
    font-size: clamp(42px, 7vw, 92px);
    line-height: 1.35;
    letter-spacing: 0;
  }

</style>

<script>
  // The scene is a slow, calm loop: it plays while it is on screen and rests when scrolled away.
  const video = document.querySelector<HTMLVideoElement>('[data-scene]');
  if (video) {
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? video.play().catch(() => {}) : video.pause())).observe(video);
  }
</script>
