---
/** BasilForge's mark: a B inside a crystal, in the scene's moonlit blues. Kairos keeps its own ring. */
interface Props {
  size?: number;
}

const { size = 30 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true" style="flex: none">
  <defs>
    <linearGradient id="bf-crystal" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e6eeff" />
      <stop offset=".45" stop-color="#8fa8ff" />
      <stop offset="1" stop-color="#3d55d6" />
    </linearGradient>
  </defs>
  <path d="M32 3l27 29-27 29L5 32z" stroke="url(#bf-crystal)" stroke-width="4" stroke-linejoin="round" />
  <path d="M25 19h9a6.5 6.5 0 0 1 0 13h-9zM25 32h10.5a6.5 6.5 0 0 1 0 13H25z" stroke="#e6eeff" stroke-width="4" stroke-linejoin="round" />
</svg>
