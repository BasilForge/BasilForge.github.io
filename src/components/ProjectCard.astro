---
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import { localePath, t, type Lang } from '../i18n/ui';
import { formatCount } from '../lib/format';
import type { Project } from '../projects';
import type { KairosStats } from '../lib/github';

interface Props {
  project: Project;
  lang: Lang;
  stats: KairosStats;
}

const { project, lang, stats } = Astro.props;
const s = t(lang);
const details = localePath(lang, `/${project.slug}/`);
---

<article class="card project" data-reveal>
  <div class="text">
    <a class="logo" href={details}><img src={project.logo} alt={project.name} width="250" height="70" /></a>
    <p class="tagline">{project.tagline[lang]}</p>
    <p class="downloads">
      <span class="num display-title" dir="ltr" data-stat="downloads">{formatCount(stats.downloads, lang)}</span>
      <span class="label"><Icon name="github" />{s['card.downloads']}</span>
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={stats.setupUrl} data-setup-link>
        <Icon name="download" />{s.download}
        <span class="btn-badge" data-stat="version" dir="ltr">v{stats.version}</span>
      </a>
      <a class="btn btn-ghost" href={details}>{s.details}<Icon name="arrow" class="flip-rtl" /></a>
    </div>
  </div>
  <a class="picture" href={details} tabindex="-1" aria-hidden="true">
    <Shot slug={project.slug} lang={lang} image={project.hero.image} alt="" sizes="(min-width: 960px) 560px, 92vw" />
  </a>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(22px, 4vw, 48px);
    overflow: hidden;
  }

  .logo img {
    height: 52px;
    width: auto;
  }

  .tagline {
    margin-top: 18px;
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--muted);
  }

  /* the GitHub download count, large in the title's crystal gradient */
  .downloads {
    display: grid;
    gap: 2px;
    margin-top: 22px;
    padding-inline-start: 18px;
    border-inline-start: 2px solid rgb(127 156 255 / 0.45);
  }

  .downloads .num {
    justify-self: start;
    font-size: clamp(40px, 4.6vw, 56px);
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .downloads .label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 15px;
  }

  .downloads :global(svg) {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .picture {
    display: block;
    transition: transform 260ms ease;
  }

  .picture:hover {
    transform: translateY(-3px);
  }

  @media (max-width: 860px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
