---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { altPath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  /** The other language's page when it is not the twin of `path` (the 404 page has none). */
  altHref?: string;
}

const { lang, title, description, path, ogImage = '/media/kairos/og.png', altHref } = Astro.props;
const site = Astro.site!;
const url = new URL(path, site).href;
const other = altHref ?? altPath(path, lang);
const enPath = lang === 'en' ? path : other;
const arPath = lang === 'ar' ? path : other;
const image = new URL(ogImage, site).href;
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#bcb2a7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, site).href} />
    <link rel="alternate" hreflang="ar" href={new URL(arPath, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BasilForge" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // If the page's script never runs, nothing may stay hidden: show every section after 2.5 s.
      window.__revealFallback = setTimeout(() => document.documentElement.classList.add('reveal-all'), 2500);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t(lang)['nav.skip']}</a>
    <Header lang={lang} altHref={other} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import { startReveal, watchHeader } from '../scripts/reveal';

      clearTimeout((window as { __revealFallback?: number }).__revealFallback);
      startReveal(document, window.IntersectionObserver, matchMedia('(prefers-reduced-motion: reduce)').matches);
      watchHeader(document.querySelector<HTMLElement>('[data-header]'), window);
    </script>
  </body>
</html>
