---
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import LiveStats from './LiveStats.astro';
import { localePath, t, type Lang } from '../i18n/ui';
import { projects } from '../projects';
import { kairosStatsForBuild } from '../lib/github';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const stats = await kairosStatsForBuild();
---

<Base lang={lang} title="BasilForge" description={s['home.description']} path={localePath(lang, '/')} ogImage={projects[0].ogImage}>
  <section class="container hero">
    <p class="eyebrow" data-reveal>BasilForge</p>
    <h1 id="work-title" data-reveal>{s['home.title']}</h1>
  </section>

  <section id="work" class="container works" aria-labelledby="work-title">
    {projects.map((project) => <ProjectCard project={project} lang={lang} stats={stats} />)}
  </section>

  <LiveStats />
</Base>

<style>
  .hero {
    padding-block: clamp(48px, 8vw, 104px) clamp(28px, 4vw, 48px);
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(42px, 7.4vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  :lang(ar) h1 {
    max-width: 16ch;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .works {
    display: grid;
    gap: 24px;
    padding-bottom: clamp(56px, 9vw, 112px);
    scroll-margin-top: 84px;
  }
</style>
