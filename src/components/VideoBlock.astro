---
import type { Project } from '../projects';

interface Props {
  video: NonNullable<Project['video']>;
  label: string;
}

const { video, label } = Astro.props;
---

<figure class="video" data-reveal>
  <video controls preload="none" playsinline poster={video.poster} width={video.width} height={video.height} aria-label={label}>
    <source src={video.src} type="video/mp4" />
  </video>
</figure>

<style>
  .video {
    margin: 0;
    padding: clamp(8px, 1.4vw, 14px);
    border-radius: 26px;
    border: 1px solid rgb(163 184 255 / 0.22);
    background: linear-gradient(180deg, rgb(27 26 43 / 0.9), rgb(13 12 24 / 0.9));
    box-shadow: 0 0 0 1px rgb(74 99 224 / 0.12), 0 30px 80px -30px rgb(74 99 224 / 0.55);
  }

  video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    background: #000;
  }
</style>
