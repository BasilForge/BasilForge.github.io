---
/** A Kairos window screenshot: 1600 px and 800 px WebP from /media/<slug>/<lang>/. */
import type { Lang } from '../i18n/ui';
import shotSizes from '../data/shot-sizes.json';

interface Props {
  slug: string;
  lang: Lang;
  image: string;
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { slug, lang, image, alt, sizes, eager = false } = Astro.props;
const base = `/media/${slug}/${lang}/${image}`;
const [width, height] = (shotSizes as Record<string, number[]>)[`${slug}/${image}`] ?? [1600, 1000];
---

<img
  class="shot"
  src={`${base}.webp`}
  srcset={`${base}-800.webp 800w, ${base}.webp 1600w`}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
/>

<style>
  .shot {
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    box-shadow:
      0 1px 2px rgb(34 28 26 / 0.08),
      0 18px 40px -18px rgb(34 28 26 / 0.45);
  }
</style>
