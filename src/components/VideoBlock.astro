---
import type { Project } from '../projects';

interface Props {
  video: NonNullable<Project['video']>;
  label: string;
}

const { video, label } = Astro.props;
---

<figure class="video" data-reveal>
  <video controls preload="none" playsinline poster={video.poster} width={video.width} height={video.height} aria-label={label}>
    <source src={video.src} type="video/mp4" />
  </video>
</figure>

<style>
  .video {
    margin: 0;
    padding: clamp(8px, 1.4vw, 14px);
    border-radius: 26px;
    background: var(--text);
    box-shadow: 0 30px 60px -30px rgb(34 28 26 / 0.6);
  }

  video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    background: #000;
  }
</style>
