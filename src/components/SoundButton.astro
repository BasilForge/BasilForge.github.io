---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const label = lang === 'ar' ? 'الموسيقى' : 'Music';
---

<button class="sound" type="button" aria-label={label} aria-pressed="true" title={label} data-sound>
  <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <svg class="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M11 5 6 9H3v6h3l5 4z"></path><path d="m22 9-6 6m0-6 6 6"></path>
  </svg>
</button>

<style>
  /* sits in the header, next to the language switch: one tap mutes the music */
  .sound {
    width: 40px;
    height: 40px;
    margin-inline-start: 6px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-2) 60%, transparent);
    color: var(--text);
    cursor: pointer;
    transition: transform 200ms ease, border-color 200ms ease;
  }

  .sound:hover {
    transform: scale(1.06);
    border-color: var(--accent-text);
  }

  .off {
    width: 20px;
    height: 20px;
  }

  .bars {
    display: none;
    gap: 3px;
    align-items: end;
    height: 16px;
  }

  .bars i {
    width: 3px;
    border-radius: 2px;
    background: var(--accent-text);
    animation: eq 1.1s ease-in-out infinite;
  }

  .bars i:nth-child(2) { animation-delay: 0.25s; }
  .bars i:nth-child(3) { animation-delay: 0.5s; }
  .bars i:nth-child(4) { animation-delay: 0.15s; }

  .sound[data-playing='true'] .bars { display: flex; }
  .sound[data-playing='true'] .off { display: none; }

  @keyframes eq {
    0%, 100% { height: 4px; }
    50% { height: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bars i { animation: none; height: 12px; }
  }
</style>

<script>
  import { bindMusicButton } from '../scripts/music';

  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-sound]');
    if (button) bindMusicButton(button);
  });
</script>
